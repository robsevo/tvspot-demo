# Copy to .env.local and edit. Nothing here is a real credential.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real values.

# --------------------------------------------------------------------------
# Authentication
# --------------------------------------------------------------------------

# Sign-in accounts, as a JSON array. Login asks for all three fields.
#
# The demo account below is intentionally trivial — change it before you put
# this anywhere reachable. Add as many users as you like:
#
#   [{"username":"demo","password":"demo","secret_word":"demo"},
#    {"username":"alex","password":"...","secret_word":"..."}]
AUTH_USERS=[{"username":"demo","password":"demo","secret_word":"demo"}]

# Signs session cookies and stream tokens. Generate your own:
#
#   openssl rand -base64 32
#
# Leave it unset in development and a fixed dev value is used. In production the
# app refuses to start without a real one rather than falling back to a secret
# that is published in this repository (see lib/auth.ts:signingSecret).
JWT_SECRET=

# --------------------------------------------------------------------------
# Content sources — all optional
#
# With none of these set the app serves the bundled demo catalogue from data/,
# which is what a fresh clone does. Everything below is for pointing it at your
# own service instead.
# --------------------------------------------------------------------------

# Catalogue/metadata API. The app proxies to it under /api/lounge/*.
# BACKEND_API_URL=https://api.example.com

# Same value, exposed to the browser for client-side calls.
# NEXT_PUBLIC_BACKEND_API_URL=https://api.example.com

# Optional stream relay, used for remuxing and for sources that need to be
# fetched server-side.
# BACKEND_RELAY_URL=https://relay.example.com

# TMDB read-access token, used only for poster/backdrop artwork.
# Without it the UI falls back to text-only cards — nothing breaks.
# https://www.themoviedb.org/settings/api
# TMDB_ACCESS_TOKEN=

# Google Cast receiver application id. Casting is hidden when unset.
# NEXT_PUBLIC_CAST_APP_ID=

# --------------------------------------------------------------------------
# Link-freshness pipeline (scripts/link-freshness)
# --------------------------------------------------------------------------

# Where the pipeline gets its channel catalogue. Unset means read
# data/channels.json, which is what makes the pipeline runnable offline.
# CATALOG_URL=https://api.example.com/channels

# One header for CATALOG_URL, if it needs authentication. Format "Name: value".
# CATALOG_AUTH_HEADER=Authorization: Bearer ...

# Extra M3U/M3U8 playlists for the pipeline to ingest, comma or newline
# separated, optionally labelled as "label|url". Empty by default: this
# repository does not ship anyone else's playlist URLs. Point it at sources you
# have the right to use.
# PLAYLIST_URLS=regional|https://example.com/playlist.m3u8

# Verification tuning. Defaults are fine for a few hundred channels.
# VERIFY_CONCURRENCY=12
# VERIFY_BUDGET_MS=600000
