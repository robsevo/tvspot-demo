<?xml version="1.0" encoding="UTF-8"?>
<!--
  Samsung Tizen wrapper for TVSpot. This widget ships ONE local page
  (index.html) that immediately loads the hosted /tv experience — all app
  logic, auth, and the API proxy stay on the Vercel deployment, so the TV
  app updates itself on every deploy with no re-packaging.

  Format notes learned against a real RU7100: the application id MUST be
  "<exactly-10-alphanumeric-chars>.<name>" with package = the 10-char part,
  and the profile is "tv-samsung" — violations fail install with the opaque
  "Parsing error [118, -19]".
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://tvspot.local/tvspot-tv"
        version="1.0.0"
        viewmodes="maximized">
  <access origin="*"/>
  <tizen:application id="TVSpotTVapp.TVSpot" package="TVSpotTVapp" required_version="2.3"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <icon src="icon.png"/>
  <name>TVSpot</name>
  <tizen:allow-navigation>*</tizen:allow-navigation>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"/>
</widget>
