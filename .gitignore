# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (any stray .next/, e.g. from running next inside public/)
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the annotated template MUST ship: it is the only documentation of what
# the app reads, and the README tells you to copy it. `.env*` silently swallowed
# it — a file that exists on disk, passes every review, and simply is not in the
# repository. CI asserts it is tracked (see .github/workflows/ci.yml).
!.env.example

# vercel
.vercel

# link freshness pipeline output — COMMITTED on purpose: it is the persistent,
# accumulating "verified links" list that the nightly GitHub Action updates and
# the build imports (lib/sources.ts). Do not ignore it.

# refresh logs
.refresh*.log

# typescript
*.tsbuildinfo
next-env.d.ts

# Tizen package artifacts (built from tizen/ — see tizen/README.md)
tizen/*.wgt

# Fire TV sideload build. `public/tvspot.apk` is a *build artifact* signed with a
# release key — it is produced by `firetv/`, not edited here, and it must never be
# committed. Drop your own signed build at that path and next.config.ts will serve
# it from /fire.
public/*.apk
