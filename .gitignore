# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (any stray .next/, e.g. from running next inside public/)
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# link freshness pipeline output — COMMITTED on purpose: it is the persistent,
# accumulating "verified links" list that the nightly GitHub Action updates and
# the build imports (lib/sources.ts). Do not ignore it.

# refresh logs
.refresh*.log

# typescript
*.tsbuildinfo
next-env.d.ts

# Tizen package artifacts (built from tizen/ — see tizen/README.md)
tizen/*.wgt
