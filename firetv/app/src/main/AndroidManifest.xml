<?xml version="1.0" encoding="utf-8"?>
<!--
  Fire TV wrapper for TVSpot. Like the Samsung/Tizen package (see ../tizen/),
  this ships ONE screen: a full-screen WebView that loads the hosted /tv
  experience on the Vercel deployment. All app logic, auth, the /api proxy and
  stream verification stay server-side, so the Fire TV app updates itself on
  every deploy with no re-packaging — and looks byte-for-byte like the Samsung
  app because it IS the same /tv routes.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- TV app: declare Leanback, but require neither it nor a touchscreen so the
         APK also installs on phones/tablets for testing. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      Icon + banner both follow Google's TV app-icon spec, which is what Fire OS
      implements:
        banner  16:9, mipmap-*  — 160x90 / 240x135 / 320x180 / 480x270 / 640x360
        icon     1:1, mipmap-*  —  80    / 120     / 160     / 240     / 320
      https://developer.android.com/design/ui/tv/guides/system/tv-app-icon-guidelines

      Two things were wrong before and both produced the grey plate seen on the
      AFTT stick: the banner lived in drawable/ at 1280x720 (so at this xhdpi
      device it was not the 320x180 the row expects and got pillarboxed), and the
      icons were phone sizes (96-384) rather than the TV ladder.

      The "Your apps"/"Recently used" row draws the 1:1 ICON, not the banner —
      which is why a wide banner alone could never fill it. Both assets are now
      FULL-BLEED brand gradient with no alpha and no rounded corners, so whichever
      one a given surface picks, no grey shows through.

      roundIcon is deliberately gone: deprecated for TV per the same guidelines.
    -->
    <application
        android:allowBackup="false"
        android:banner="@mipmap/banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TVSpot"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:banner="@mipmap/banner"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
