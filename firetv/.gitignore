# The repo root ignores *.pem as a secrets rule. This one is the PUBLIC ISRG
# Root X1 CA certificate, referenced by network_security_config.xml so Fire OS 5
# can validate Let's Encrypt chains — it must be committed or the build breaks.
!app/src/main/res/raw/isrgrootx1.pem
